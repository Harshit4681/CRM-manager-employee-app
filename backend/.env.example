# Application Settings
APP_NAME="HackRx Document Retrieval System"
DEBUG=true
API_PREFIX="/api/v1"

# Server Settings
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-secret-key-here-change-in-production
BEARER_TOKEN=hackrx-demo-token
API_KEYS=["key1", "key2", "key3"]

# OpenAI Settings (Required)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=2000
EMBEDDING_MODEL=text-embedding-ada-002

# Pinecone Settings (Required)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=gcp-starter
PINECONE_INDEX_NAME=hackrx-documents
PINECONE_DIMENSION=1536

# Database Settings
DATABASE_URL=postgresql://user:password@localhost/hackrx
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Settings
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Document Processing
MAX_FILE_SIZE=52428800
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Vector Search
VECTOR_SEARCH_TOP_K=10
SIMILARITY_THRESHOLD=0.7

# Processing Limits
MAX_DOCUMENTS_PER_REQUEST=10
MAX_QUERY_LENGTH=1000
PROCESSING_TIMEOUT=300

# Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=